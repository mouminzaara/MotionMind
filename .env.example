# MotionMind Root Environment Configuration Template
# Copy this file to .env or configure respective frontend/.env and backend/.env

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=info

# Frontend Configuration
NEXT_PUBLIC_APP_NAME="MotionMind"
NEXT_PUBLIC_API_URL="http://localhost:8000"
PORT=3000

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=development_insecure_secret_key_change_in_production
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg://username:password@localhost:5432/motionmind
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/motionmind
# Set to 1 if running on systems requiring pure Python SQLAlchemy execution
DISABLE_SQLALCHEMY_CEXT=1

