# MotionMind Backend Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=info
APP_NAME="MotionMind API"
API_V1_PREFIX="/api/v1"

# Network Binding
HOST=0.0.0.0
PORT=8000

# Security (Placeholder for Phase 1 - Insecure Dev Key)
SECRET_KEY=dev_secret_key_change_me_in_production_32chars_min

# CORS: JSON-encoded list of allowed origins
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Connection
# PostgreSQL: postgresql+psycopg://username:password@localhost:5432/motionmind
# SQLite (Local test/dev fallback): sqlite:///./motionmind_dev.db
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/motionmind

# SQLAlchemy Pure Python execution flag (prevents Windows WDAC DLL issues)
DISABLE_SQLALCHEMY_CEXT=1

